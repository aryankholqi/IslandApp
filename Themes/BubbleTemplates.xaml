<!--
    How each companion looks in the round side bubble. Merged into the bubble's own resources, so these implicit
    templates win over the island's (ActivityTemplates.xaml) for the same types.
    The first 36 px is the round view; the rest is clipped away until a click widens the bubble (IslandWindow.SetPeek).
    Text carries a -2 top margin (1 px up): WPF centres the line box, and Segoe UI's box puts the visible
    letters ~1 px below centre. Same idea for the mic glyph, whose ink sits slightly high in its em box.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="clr-namespace:IslandApp.Activities"
                    xmlns:c="clr-namespace:IslandApp.Controls">

    <!-- Claude: weekly ring outside, 5-hour inside. -->
    <DataTemplate DataType="{x:Type a:ClaudeRingsActivity}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="36" Height="36">
                <c:RingGauge Width="26" Height="26" Thickness="3" Value="{Binding Usage.WeeklyFraction, Mode=OneWay}"
                             Brush="{DynamicResource AccentBrush}" TrackBrush="{StaticResource TrackBrush}" />
                <c:RingGauge Width="15" Height="15" Thickness="2.5" Value="{Binding Usage.FiveHourFraction, Mode=OneWay}"
                             Brush="{StaticResource SnowBrush}" TrackBrush="{StaticResource TrackBrush}" />
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,-2,0,0">
                <TextBlock Text="{Binding Usage.WeeklyText}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource NumericText}" />
                <TextBlock Text="week" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="3,1,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Usage.FiveHourText}" FontSize="13" Margin="9,0,0,0" Style="{StaticResource NumericText}" />
                <TextBlock Text="{Binding Usage.FiveHourLeftText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="3,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Timer: a ring that empties as time runs out; widened, the time plus pause/resume and cancel. -->
    <DataTemplate DataType="{x:Type a:TimerActivity}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="36" Height="36">
                <c:RingGauge Width="26" Height="26" Thickness="3" Value="{Binding Fraction, Mode=OneWay}"
                             Brush="{DynamicResource AccentBrush}" TrackBrush="{StaticResource TrackBrush}" />
                <TextBlock Text="&#xE916;" Style="{StaticResource IconText}" FontSize="10"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            </Grid>
            <TextBlock Text="{Binding RemainingText}" FontSize="13" Margin="4,-2,8,0"
                       Foreground="{DynamicResource AccentBrush}" Style="{StaticResource NumericText}" />
            <Button Style="{StaticResource CircleButton}" Width="26" Height="26" FontSize="11" VerticalAlignment="Center"
                    Command="{Binding ToggleCommand}" AutomationProperties.Name="Pause or resume timer">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE768;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Text" Value="&#xE769;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource CircleButton}" Width="26" Height="26" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                    Content="&#xE711;" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel timer" />
        </StackPanel>
    </DataTemplate>

    <!-- Screen / camera / microphone: the device icon; widened, how long and which app. -->
    <DataTemplate DataType="{x:Type a:CaptureActivity}">
        <StackPanel Orientation="Horizontal">
            <!-- Closed, the bubble is exactly as wide as these icons (CaptureActivity.BubbleWidth); MinWidth and the time's
                 6 px margin keep the time outside it. Widened, the time and app follow. -->
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CaptureIcons}" Height="36" MinWidth="26" Margin="10,1,0,0" />
            <TextBlock Text="{Binding DurationText}" FontSize="13" Margin="6,-2,8,0" Style="{StaticResource NumericText}" />
            <TextBlock Text="{Binding AppName}" FontSize="12" Foreground="{StaticResource MutedBrush}" MaxWidth="72"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,-2,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- IDM download: only the progress ring, in IDM's progress-bar green; widened, the speed and time left. -->
    <DataTemplate DataType="{x:Type a:DownloadActivity}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="36" Height="36">
                <c:RingGauge Width="26" Height="26" Thickness="3" Value="{Binding Fraction, Mode=OneWay}"
                             Brush="#06B025" TrackBrush="{StaticResource TrackBrush}" />
            </Grid>
            <TextBlock Text="{Binding SpeedText}" FontSize="13" Margin="4,-2,8,0" Style="{StaticResource NumericText}" />
            <TextBlock Text="{Binding TimeLeftText}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,-2,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- File shelf: the first file's icon; widened, the count. Drag the bubble to take every file out (IslandWindow). -->
    <DataTemplate DataType="{x:Type a:ShelfActivity}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="36" Height="36">
                <Image Source="{Binding FirstIcon}" Width="20" Height="20" />
            </Grid>
            <TextBlock Text="{Binding CountText}" FontSize="13" Margin="4,-2,8,0" MaxWidth="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- Battery: a ring with the percentage inside; widened, the percentage and status. -->
    <DataTemplate DataType="{x:Type a:BatteryActivity}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="36" Height="36">
                <c:RingGauge Width="28" Height="28" Thickness="2.5" Value="{Binding Fraction, Mode=OneWay}" Style="{StaticResource BatteryRing}" />
                <TextBlock Text="{Binding PercentNumber}" FontSize="9" FontWeight="SemiBold" Margin="0,-1,0,0"
                           HorizontalAlignment="Center" Style="{StaticResource NumericText}" />
            </Grid>
            <TextBlock Text="{Binding PercentText}" FontSize="13" Margin="4,-2,8,0" Style="{StaticResource NumericText}" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,-2,0,0" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
