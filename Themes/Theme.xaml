<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:conv="clr-namespace:IslandApp.Converters"
                    mc:Ignorable="po">

    <!-- Palette. Accent* and ArtworkFallbackBrush are replaced at runtime from the accent setting (App.ApplyAccent), so use them via DynamicResource. -->
    <Color x:Key="AccentColor">#F42902</Color>
    <Color x:Key="SnowColor">#FDFDFF</Color>
    <Color x:Key="PunkColor">#83FD80</Color>
    <Color x:Key="IslandColor">#0B0C11</Color>
    <Color x:Key="MutedColor">#9A9CAA</Color>
    <Color x:Key="TrackColor">#262836</Color>
    <Color x:Key="WindowColor">#111218</Color>

    <!-- Frozen brushes are shareable across threads and cheaper to render. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EF42902" po:Freeze="True" />
    <SolidColorBrush x:Key="SnowBrush" Color="{StaticResource SnowColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="PunkBrush" Color="{StaticResource PunkColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandBrush" Color="{StaticResource IslandColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandStrokeBrush" Color="#12FDFDFF" po:Freeze="True" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" po:Freeze="True" />
    <LinearGradientBrush x:Key="ArtworkFallbackBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#F42902" Offset="0" />
        <GradientStop Color="#FF9A3D" Offset="1" />
    </LinearGradientBrush>

    <!-- Type -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <conv:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    <conv:BoolToVisibilityConverter x:Key="CollapsedWhenTrue" Invert="True" />

    <!-- Shown only without artwork; underneath a cover its anti-aliased edge reads as a border. -->
    <Style x:Key="ArtworkFallback" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource SnowBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NumericText" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Round button; Background and Foreground are set per use. -->
    <Style x:Key="CircleButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource SnowBrush}" />
        <Setter Property="Background" Value="{StaticResource TrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource CircleButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

</ResourceDictionary>
