<Window x:Class="IslandApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:IslandApp.Views"
        Title="Island Settings"
        Width="460" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/IslandSettings.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource SnowBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1B23" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#23252F" />
        <SolidColorBrush x:Key="FieldBrush" Color="#23252F" />
        <SolidColorBrush x:Key="SwitchOffBrush" Color="#2E3040" />

        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="6,22,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- A settings row: glyph (Tag, optional), label (Content) and a switch. Clicking anywhere on the row toggles it. -->
        <Style x:Key="SwitchRow" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SnowBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Right" Width="40" Height="22" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border x:Name="Track" CornerRadius="11" Background="{StaticResource SwitchOffBrush}"
                                            BorderBrush="{StaticResource SnowBrush}" BorderThickness="0" />
                                    <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3,0,0,0"
                                             HorizontalAlignment="Left" Fill="{StaticResource MutedBrush}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="Slide" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{TemplateBinding Tag}" Style="{StaticResource IconText}"
                                           Foreground="{StaticResource MutedBrush}" Width="30" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource SnowBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A smaller switch row for options under a feature. -->
        <Style x:Key="SubSwitch" TargetType="CheckBox" BasedOn="{StaticResource SwitchRow}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="RowCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- Option rows sit under their feature, aligned with its label. -->
        <Style x:Key="Options" TargetType="StackPanel">
            <Setter Property="Margin" Value="38,0,12,10" />
        </Style>

        <Style x:Key="OptionRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="8,4" />
        </Style>

        <!-- Segmented picker: a ListBox of Option(Label, Value) bound by SelectedValue. No inner ScrollViewer, so the wheel scrolls the page. -->
        <Style x:Key="Segmented" TargetType="ListBox">
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="9" Padding="2">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Segment" Background="Transparent" CornerRadius="7" Padding="10,4"
                                            BorderBrush="{StaticResource SnowBrush}" BorderThickness="0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Segment" Property="Background" Value="{StaticResource SwitchOffBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource SnowBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource SnowBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Segment" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent swatches: same picker, drawn as colour dots with a ring on the selected one. -->
        <Style x:Key="Swatches" TargetType="ListBox" BasedOn="{StaticResource Segmented}">
            <Setter Property="DisplayMemberPath" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Ellipse Width="18" Height="18" Fill="{Binding Value}" ToolTip="{Binding Label}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Ring" Padding="2" Margin="1" CornerRadius="999"
                                            BorderThickness="2" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SwitchOffBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SnowBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field. The binding commits when the field loses focus. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource SnowBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource SnowBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="8,6"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scrollbar for the page. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A3D4C" CornerRadius="4" Margin="2,4" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="20,22,20,18">
            <!-- Header: a miniature island as the logo. -->
            <DockPanel Margin="6,0,0,0">
                <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource ArtworkFallbackBrush}">
                    <Border Width="30" Height="11" CornerRadius="5.5" Background="{StaticResource IslandBrush}" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Island" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Settings" Style="{StaticResource CaptionText}" FontSize="13" />
                </StackPanel>
            </DockPanel>

            <!-- General -->
            <TextBlock Text="GENERAL" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <CheckBox Style="{StaticResource SwitchRow}" Tag="&#xE7E8;" IsChecked="{Binding StartWithWindows}"
                          AutomationProperties.Name="Start with Windows">
                    <StackPanel>
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Open Island when you sign in" Style="{StaticResource RowCaption}" />
                    </StackPanel>
                </CheckBox>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="8,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Swatches}" AutomationProperties.Name="Accent colour"
                                 ItemsSource="{x:Static v:SettingsOptions.Accents}" SelectedValue="{Binding Accent}" />
                        <TextBlock Text="Accent" Style="{StaticResource OptionLabel}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Size"
                                 ItemsSource="{x:Static v:SettingsOptions.Sizes}" SelectedValue="{Binding Scale}" />
                        <TextBlock Text="Size" Style="{StaticResource OptionLabel}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Glow"
                                 ItemsSource="{x:Static v:SettingsOptions.Glows}" SelectedValue="{Binding GlowOpacity}" />
                        <TextBlock Text="Glow" Style="{StaticResource OptionLabel}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Animation"
                                 ItemsSource="{x:Static v:SettingsOptions.Speeds}" SelectedValue="{Binding AnimationSpeed}" />
                        <TextBlock Text="Animation" Style="{StaticResource OptionLabel}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Position -->
            <TextBlock Text="POSITION" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="8,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox x:Name="MonitorPicker" DockPanel.Dock="Right" Style="{StaticResource Segmented}" MaxWidth="320"
                                 AutomationProperties.Name="Display" SelectedValue="{Binding Monitor}" />
                        <TextBlock Text="Display" Style="{StaticResource OptionLabel}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Distance from top"
                                 ItemsSource="{x:Static v:SettingsOptions.TopOffsets}" SelectedValue="{Binding TopOffset}" />
                        <TextBlock Text="Distance from top" Style="{StaticResource OptionLabel}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="8,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Collapse after"
                                 ItemsSource="{x:Static v:SettingsOptions.CollapseDelays}" SelectedValue="{Binding CollapseSeconds}" />
                        <TextBlock Text="Collapse after" Style="{StaticResource OptionLabel}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Bubble closes after"
                                 ItemsSource="{x:Static v:SettingsOptions.CollapseDelays}" SelectedValue="{Binding BubbleCollapseSeconds}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Bubble closes after" FontSize="13" />
                            <TextBlock Text="After you click it" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource OptionRow}">
                        <TextBox DockPanel.Dock="Right" Width="140" Style="{StaticResource Field}"
                                 AutomationProperties.Name="Timer presets" Text="{Binding TimerPresets}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Timer presets" FontSize="13" />
                            <TextBlock Text="Minutes, separated by commas" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Features -->
            <TextBlock Text="SHOW ON THE ISLAND" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="MediaSwitch" Style="{StaticResource SwitchRow}" Tag="&#xE8D6;" IsChecked="{Binding ShowMedia}"
                              AutomationProperties.Name="Media">
                        <StackPanel>
                            <TextBlock Text="Media" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Now playing, with controls" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Style="{StaticResource Options}"
                                Visibility="{Binding IsChecked, ElementName=MediaSwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <CheckBox Style="{StaticResource SubSwitch}" IsChecked="{Binding ArtworkGlow}" Content="Colours from the album cover" />
                        <CheckBox Style="{StaticResource SubSwitch}" IsChecked="{Binding SyncWaveform}" Content="Bars follow the sound" />
                    </StackPanel>

                    <CheckBox x:Name="VolumeSwitch" Style="{StaticResource SwitchRow}" Tag="&#xE767;" IsChecked="{Binding ShowVolume}"
                              AutomationProperties.Name="Volume">
                        <StackPanel>
                            <TextBlock Text="Volume" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="When the volume changes" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Style="{StaticResource Options}"
                                Visibility="{Binding IsChecked, ElementName=VolumeSwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel Style="{StaticResource OptionRow}">
                            <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Volume shows for"
                                     ItemsSource="{x:Static v:SettingsOptions.VolumeDurations}" SelectedValue="{Binding VolumeSeconds}" />
                            <TextBlock Text="Show for" Style="{StaticResource OptionLabel}" />
                        </DockPanel>
                    </StackPanel>

                    <CheckBox x:Name="NotificationsSwitch" Style="{StaticResource SwitchRow}" Tag="&#xEA8F;" IsChecked="{Binding ShowNotifications}"
                              AutomationProperties.Name="Notifications">
                        <StackPanel>
                            <TextBlock Text="Notifications" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Sender and message" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Style="{StaticResource Options}"
                                Visibility="{Binding IsChecked, ElementName=NotificationsSwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel Style="{StaticResource OptionRow}">
                            <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Notifications from"
                                     ItemsSource="{x:Static v:SettingsOptions.NotificationSources}" SelectedValue="{Binding NotificationsFromAllApps}" />
                            <TextBlock Text="From" Style="{StaticResource OptionLabel}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource OptionRow}">
                            <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Notifications show for"
                                     ItemsSource="{x:Static v:SettingsOptions.NotificationDurations}" SelectedValue="{Binding NotificationSeconds}" />
                            <TextBlock Text="Show for" Style="{StaticResource OptionLabel}" />
                        </DockPanel>
                    </StackPanel>

                    <CheckBox x:Name="ChargingSwitch" Style="{StaticResource SwitchRow}" Tag="&#xEBB5;" IsChecked="{Binding ShowCharging}"
                              AutomationProperties.Name="Charging">
                        <StackPanel>
                            <TextBlock Text="Charging" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="When the charger is plugged in or out" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Style="{StaticResource Options}"
                                Visibility="{Binding IsChecked, ElementName=ChargingSwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel Style="{StaticResource OptionRow}">
                            <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Charging shows for"
                                     ItemsSource="{x:Static v:SettingsOptions.ChargingDurations}" SelectedValue="{Binding ChargingSeconds}" />
                            <TextBlock Text="Show for" Style="{StaticResource OptionLabel}" />
                        </DockPanel>
                    </StackPanel>

                    <CheckBox x:Name="BatterySwitch" Style="{StaticResource SwitchRow}" Tag="&#xEBAA;" IsChecked="{Binding ShowBattery}"
                              AutomationProperties.Name="Battery">
                        <StackPanel>
                            <TextBlock Text="Battery" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="A ring when it's low or charging (laptops)" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Style="{StaticResource Options}"
                                Visibility="{Binding IsChecked, ElementName=BatterySwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel Style="{StaticResource OptionRow}">
                            <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Battery shows below"
                                     ItemsSource="{x:Static v:SettingsOptions.BatteryLevels}" SelectedValue="{Binding BatteryLowPercent}" />
                            <TextBlock Text="Show below" Style="{StaticResource OptionLabel}" />
                        </DockPanel>
                        <CheckBox Style="{StaticResource SubSwitch}" IsChecked="{Binding BatteryWhileCharging}" Content="While charging" />
                    </StackPanel>

                    <CheckBox x:Name="PrivacySwitch" Style="{StaticResource SwitchRow}" Tag="&#xE720;" IsChecked="{Binding ShowPrivacy}"
                              AutomationProperties.Name="Microphone, camera and screen sharing">
                        <StackPanel>
                            <TextBlock Text="Microphone, camera &amp; screen" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Shows while in use, with how long" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Style="{StaticResource Options}"
                                Visibility="{Binding IsChecked, ElementName=PrivacySwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <CheckBox Style="{StaticResource SubSwitch}" IsChecked="{Binding PrivacyFlash}" Content="Announce which app starts using them" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Claude -->
            <TextBlock Text="CLAUDE" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="ClaudeSwitch" Style="{StaticResource SwitchRow}" Tag="&#xE9D9;" IsChecked="{Binding ClaudeConnected}"
                              AutomationProperties.Name="Claude usage">
                        <StackPanel>
                            <TextBlock Text="Claude usage" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Adds Island as Claude Code's status line" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </CheckBox>

                    <!-- Usage bars; DataContext is the ClaudeActivity (set in code). -->
                    <StackPanel x:Name="ClaudeUsagePanel" Margin="54,0,16,8"
                                Visibility="{Binding IsChecked, ElementName=ClaudeSwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel Visibility="{Binding HasData, Converter={StaticResource VisibleWhenTrue}}">
                            <DockPanel Margin="0,4,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding WeeklyText}" FontSize="13" Style="{StaticResource NumericText}" />
                                <TextBlock Text="Weekly" FontSize="13" />
                            </DockPanel>
                            <Grid Height="6">
                                <Border Background="{StaticResource TrackBrush}" CornerRadius="3" />
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding WeeklyFraction, Mode=OneWay}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding WeeklyResetText}" Style="{StaticResource RowCaption}" Margin="0,6,0,0" />

                            <DockPanel Margin="0,14,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FiveHourText}" FontSize="13" Style="{StaticResource NumericText}" />
                                <TextBlock Text="5-hour" FontSize="13" />
                            </DockPanel>
                            <Grid Height="6">
                                <Border Background="{StaticResource TrackBrush}" CornerRadius="3" />
                                <Border Background="{StaticResource SnowBrush}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding FiveHourFraction, Mode=OneWay}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding FiveHourResetText}" Style="{StaticResource RowCaption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource RowCaption}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Claude options (bound to the settings). -->
                    <StackPanel Style="{StaticResource Options}"
                                Visibility="{Binding IsChecked, ElementName=ClaudeSwitch, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel Style="{StaticResource OptionRow}">
                            <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" AutomationProperties.Name="Show weekly usage every"
                                     ItemsSource="{x:Static v:SettingsOptions.ClaudeSteps}" SelectedValue="{Binding ClaudeStep}" />
                            <TextBlock Text="Show weekly usage every" Style="{StaticResource OptionLabel}" />
                        </DockPanel>
                        <CheckBox x:Name="RingsSwitch" Style="{StaticResource SubSwitch}" IsChecked="{Binding ClaudeRingsInIde}"
                                  Content="Rings while an IDE is in front" />
                        <StackPanel Margin="8,4,8,4"
                                    Visibility="{Binding IsChecked, ElementName=RingsSwitch, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="IDE apps" FontSize="13" />
                            <TextBlock Text="Process names, separated by commas" Style="{StaticResource RowCaption}" Margin="0,2,0,6" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding IdeApps}" AutomationProperties.Name="IDE apps"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" FontSize="11" Margin="6,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
