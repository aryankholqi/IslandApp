<Window x:Class="IslandApp.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island"
        Width="560" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource SnowBrush}"
        UseLayoutRounding="True">

    <!-- Only the pill is hit-testable; the transparent rest of the window passes clicks through. -->
    <!-- The island plus an optional round bubble on its right; the pair stays centred. -->
    <!-- RootScale is the "Size" setting. A LayoutTransform (not RenderTransform) so layout sees the scaled size and
         never clips it; the window is resized to match in ApplySettings. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
    <StackPanel.LayoutTransform>
        <ScaleTransform x:Name="RootScale" />
    </StackPanel.LayoutTransform>
    <Grid x:Name="Island"
          Width="126" Height="34" Margin="0,8,0,0"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          RenderTransformOrigin="0.5,0" Cursor="Hand"
          MouseEnter="OnIslandMouseEnter"
          MouseLeave="OnIslandMouseLeave"
          MouseLeftButtonUp="OnIslandMouseLeftButtonUp"
          ContextMenuOpening="OnIslandContextMenuOpening"
          AllowDrop="True" DragEnter="OnShelfDragEnter" DragOver="OnShelfDragOver" Drop="OnShelfDrop"
          PreviewMouseLeftButtonDown="OnShelfPressed" PreviewMouseMove="OnShelfMouseMove" PreviewMouseLeftButtonUp="OnShelfReleased">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="HoverScale" />
        </Grid.RenderTransform>

        <Grid.ContextMenu>
            <ContextMenu HasDropShadow="False" Padding="0">
                <ContextMenu.Template>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- Margin leaves room for the shadow inside the transparent popup. -->
                        <Border Margin="12" Padding="6" MinWidth="180" CornerRadius="14"
                                Background="{StaticResource IslandBrush}"
                                BorderBrush="{StaticResource IslandStrokeBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </ContextMenu.Template>
                <ContextMenu.Resources>
                    <!-- Implicit, so the timer items added in code pick them up too. -->
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="{StaticResource SnowBrush}" />
                        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="Bg" Padding="12,7" CornerRadius="8" Background="Transparent">
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TrackBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- Menus force this key on their separators, so an implicit style is ignored. -->
                    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Height="1" Margin="8,5" Background="{StaticResource TrackBrush}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContextMenu.Resources>
                <!-- Timer presets are inserted above this separator when the menu opens. -->
                <Separator x:Name="TimerSeparator" />
                <MenuItem Header="Claude usage" Command="{Binding ShowClaudeUsageCommand}" />
                <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Rectangle x:Name="Pill"
                   RadiusX="17" RadiusY="17"
                   Fill="{StaticResource IslandBrush}"
                   Stroke="{StaticResource IslandStrokeBrush}" StrokeThickness="1">
            <Rectangle.Effect>
                <DropShadowEffect x:Name="Glow" BlurRadius="26" ShadowDepth="0" Opacity="0.45"
                                  Color="Black" RenderingBias="Quality" /> <!-- Performance blurs blotchily on the large expanded pill -->
            </Rectangle.Effect>
        </Rectangle>

        <!-- Sized to the target shape by the code-behind and centred; the pill clips it while morphing. -->
        <ContentPresenter x:Name="ActivityHost"
                          Width="126" Height="34"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          Content="{Binding Coordinator.Current}"
                          ClipToBounds="True">
            <ContentPresenter.RenderTransform>
                <ScaleTransform x:Name="ContentScale" />
            </ContentPresenter.RenderTransform>
        </ContentPresenter>
    </Grid>

    <!-- Width and left margin animate from 0, so the bubble grows out of the island's side. A click widens it
         into a pill for a moment (SetPeek); the corner radius keeps it a circle at 36 wide. -->
    <Grid x:Name="Bubble" Width="0" Height="36" Margin="0,8,0,0" VerticalAlignment="Top" Opacity="0" ClipToBounds="True"
          Cursor="Hand" MouseLeftButtonUp="OnBubbleMouseLeftButtonUp"
          AllowDrop="True" DragOver="OnShelfDragOver" Drop="OnShelfDrop"
          PreviewMouseLeftButtonDown="OnShelfPressed" PreviewMouseMove="OnShelfMouseMove" PreviewMouseLeftButtonUp="OnShelfReleased">
        <Grid.Resources>
            <ResourceDictionary Source="/Themes/BubbleTemplates.xaml" />
        </Grid.Resources>
        <Border Background="{StaticResource IslandBrush}" BorderBrush="{StaticResource IslandStrokeBrush}" BorderThickness="1" CornerRadius="18" />
        <!-- The Canvas lets the content measure at its natural width (not clipped to the bubble), which sizes the peek. -->
        <Canvas>
            <ContentPresenter x:Name="BubbleContent" Content="{Binding Coordinator.Companion}" SizeChanged="OnBubbleContentSizeChanged" />
        </Canvas>
    </Grid>

    </StackPanel>
</Window>
