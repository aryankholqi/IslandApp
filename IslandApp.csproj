<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>IslandApp</RootNamespace>
    <AssemblyName>Island</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Island.ico</ApplicationIcon>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Startup & runtime performance -->
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noto Color Emoji (Apache 2.0, Google), 48px, from the emoji-datasource-google 16.0.0 npm package. -->
    <Content Include="Assets\emoji.zip" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\NotoEmoji-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Window icon (embedded) and the Start menu / desktop shortcut icon (file) for "Island Settings". -->
    <Resource Include="Assets\IslandSettings.ico" />
    <Content Include="Assets\IslandSettings.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
